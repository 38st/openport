set(OPENPORT_BUILD_REVISION "" CACHE STRING "Source revision for builds without Git metadata")
if(NOT OPENPORT_BUILD_REVISION)
  execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE OPENPORT_BUILD_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(OPENPORT_BUILD_REVISION)
    execute_process(COMMAND git diff --quiet HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
      RESULT_VARIABLE OPENPORT_DIRTY ERROR_QUIET)
    if(OPENPORT_DIRTY)
      string(APPEND OPENPORT_BUILD_REVISION "-dirty")
    endif()
  else()
    set(OPENPORT_BUILD_REVISION "unknown")
  endif()
endif()
if(NOT OPENPORT_BUILD_REVISION MATCHES "^[A-Za-z0-9._+-]+$")
  message(FATAL_ERROR "OPENPORT_BUILD_REVISION must be a plain revision identifier")
endif()
add_library(openport_build_info INTERFACE)
target_compile_definitions(openport_build_info INTERFACE
  OPENPORT_BUILD_REVISION="${OPENPORT_BUILD_REVISION}"
  OPENPORT_BUILD_COMPILER="${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}"
  OPENPORT_BUILD_PLATFORM="${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
